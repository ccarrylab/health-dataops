# GitHub Secrets (set in repo Settings → Secrets → Actions)
#
# AWS_GITHUB_ROLE_ARN=arn:aws:iam::<account-id>:role/dev-github-terraform-role
# MWAA_DAG_BUCKET=s3://dev-health-mwaa-dags-<account-id>
# ARTIFACT_BUCKET=s3://dev-health-silver-<account-id>
#
# Airflow Variables (set in MWAA UI → Admin → Variables)
# raw_bucket=<terraform output raw_bucket>
# curated_bucket=<terraform output gold_bucket>
# artifact_bucket=<terraform output silver_bucket>
# use_serverless=false  # Set to true for cost-optimized mode
